# === NEBULA OS BOOT SEQUENCER ===

term.clear()

# 1. Draw Header Logo
term.move(2, 10)
print(term.color("cyan") + "╔══════════════════════════════════╗" + term.reset())
term.move(3, 10)
print(term.color("cyan") + "║      C H A I N - L A N G         ║" + term.reset())
term.move(4, 10)
print(term.color("cyan") + "╚══════════════════════════════════╝" + term.reset())

term.move(6, 10)
print("System Version: " + term.color("yellow") + "v0.4a (Alpha Release)" + term.reset())

# 2. Loading Bar Simulation
set steps = [
    "Kernel Initialization...",
    "Mounting File System...",
    "Loading Drivers (math_tools)...",
    "Starting Network Service...",
    "User Interface Ready."
]

set y_pos = 12

for status in steps {
    # Status Shows Up
    term.move(y_pos, 10)
    print(term.color("white") + "[ " + term.color("green") + "OK" + term.color("white") + " ] " + status + term.reset())
    
    # Loading Animation (Take Your Time Grab a Coffee :D)
    time.sleep(800)
    
    set y_pos = y_pos + 1
}

term.move(y_pos + 2, 10)
print(term.color("magenta") + ">>> WELCOME TO NEBULA TERMINAL <<<" + term.reset())

term.move(y_pos + 8, 2)
print(" ")

time.sleep(2000)

# 3. Moving to a Demo Shell 
import "shell.chain"
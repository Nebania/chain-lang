# highlighter.chain

func getKeywordColor(word) {
    # Trim whitespace
    set w = str.trim(word)
    
    # Primary Keywords (Cyan/Magenta)
    if w == "func" or w == "class" or w == "set" or w == "import" { return "cyan" }
    if w == "if" or w == "else" or w == "while" or w == "for" or w == "return" { return "magenta" }
    
    # Data Types & Booleans (Yellow/Orange)
    if w == "true" or w == "false" or w == "null" { return "yellow" }
    
    # Built-in Functions (Green)
    if w == "print" or str.contains(w, "math.") or str.contains(w, "gui_") { return "green" }
    
    # Default Text (White)
    return "white"
}

# Function to render a single line of syntax-highlighted text
func drawHighlightedLine(x, y, text, fontSize) {
    set words = str.split(text, " ")
    set currentX = x
    
    for i in range(len(words)) {
        set word = words[i]
        set color = getKeywordColor(word)
        
        # Check if word is a string literal (Quotes)
        if str.contains(word, "\"") { set color = "yellow" }
        
        # Render the current word
        gui_text(currentX, y, word, color, fontSize)
        
        # Shift X position for the next word (+ space)
        set wordWidth = gui_measure_text(word + " ", fontSize)
        set currentX = currentX + wordWidth
    }
}